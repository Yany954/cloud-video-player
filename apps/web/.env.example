# Copy to .env.local and fill in from the CDK stack outputs
# (aws cloudformation describe-stacks --stack-name cvp-dev-auth / cvp-dev-api).
# These are public identifiers, not secrets: they are visible in any browser.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
